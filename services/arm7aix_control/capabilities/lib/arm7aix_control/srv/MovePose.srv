# Cartesian tool pose target in the configured base frame (base_link).
# Position in metres; orientation quaternion in xyzw order (normalised by
# the arm primitive).
float64 x
float64 y
float64 z
float64 qx
float64 qy
float64 qz
float64 qw
---
bool accepted
# true = tool pose is within the configured position/angle tolerances.
bool reached
# true = motion_timeout_sec elapsed without reaching the target.
bool timed_out
float64 elapsed_sec
float64[7] final_positions
string detail
