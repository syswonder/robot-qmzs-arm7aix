# No request fields: read the cached feedback.
---
# Latest measured joint state (order = deployment joint_names), radians / rad/s / Nm.
float64[7] positions
float64[7] velocities
float64[7] efforts
# Latest tool pose in the base frame: metres + quaternion xyzw.
float64 x
float64 y
float64 z
float64 qx
float64 qy
float64 qz
float64 qw
# valid=false when no fresh joint feedback arrived within feedback_stale_sec.
bool valid
float64 feedback_age_sec
string detail
